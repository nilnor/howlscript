howlscript = require('howlscript')
targets = require('howlscript.targets')
{:dedent, :with_tmpfile} = require('spec.support')

describe 'howlscript', ->
  describe 'to_lua(source, opts)', ->
    it 'returns the Lua for the source', ->
      assert.equals 'local x = 1', howlscript.to_lua('x = 1')

    it 'returns nil and a formatted error for invalid source', ->
      lua, err = howlscript.to_lua('x = (', chunkname: '@dir/file.howl')
      assert.is_nil lua
      assert.equals "dir/file.howl:1:6: unexpected end of input\n  x = (\n       ^", err

    it 'returns the error as a table too, with its byte column and length', ->
      _, _, err = howlscript.to_lua("x = 'å' foo")
      -- the å takes two bytes
      assert.same {line: 1, col: 10, len: 3, message: "unexpected 'foo'"}, err

      _, _, err = howlscript.to_lua('buffer = 1\nf = (buffer) -> 1')
      assert.same {2, 6, 6}, {err.line, err.col, err.len}
      assert.match err.message, "parameter 'buffer' shadows"

    it 'leaves out the length when the error is not about a token of known size', ->
      _, _, err = howlscript.to_lua('x = "abc')
      assert.same {line: 1, col: 5, message: 'unterminated string'}, err

    it 'names the source <howlscript> without a chunk name', ->
      _, err = howlscript.to_lua('f!')
      assert.match err, '^<howlscript>:1:2:'

    describe 'with opts.target', ->
      src = dedent([[
        s = 'caf\u{e9}'
        for i = 1, 2
          i *= 10
          s ..= ' ' .. i
        s
      ]])

      it 'compiles for the Lua it names, whichever Lua runs the compiler', ->
        assert.equals dedent([[
          local s = 'caf\u{e9}'
          for i = 1, 2 do
            i = i * 10
            s = s .. ' ' .. i end
          return s]]), howlscript.to_lua(src, target: '5.4')
        -- Lua 5.2 lacks \u{XXX} escapes
        assert.equals dedent([[
          local s = 'caf\195\169'
          for i = 1, 2 do
            i = i * 10
            s = s .. ' ' .. i end
          return s]]), howlscript.to_lua(src, target: '5.2')
        -- Lua 5.5 makes loop variables constants
        assert.equals dedent([[
          local s = 'caf\u{e9}'
          for __hs_i1 = 1, 2 do local i = __hs_i1
            i = i * 10
            s = s .. ' ' .. i end
          return s]]), howlscript.to_lua(src, target: '5.5')
        assert.equals 'local x = 10LL', howlscript.to_lua('x = 10LL', target: 'luajit')
        _, err = howlscript.to_lua('x = 10LL', target: '5.4')
        assert.match err, '64%-bit integer and imaginary numbers need LuaJIT'

      it 'compiles Lua that loads on every Lua for portable', ->
        lua = howlscript.to_lua(src, target: 'portable')
        assert.equals dedent([[
          local s = 'caf\195\169'
          for __hs_i1 = 1, 2 do local i = __hs_i1
            i = i * 10
            s = s .. ' ' .. i end
          return s]]), lua
        -- the specs run under every Lua, so this loads it in each
        assert.equals 'café 10 20', load(lua)()
        _, err = howlscript.to_lua('x = 10LL', target: 'portable')
        assert.match err, 'need LuaJIT'

      it 'is the running Lua by default, which targets.lua describes as runtime.lua finds it', ->
        running = jit and 'luajit' or _VERSION:match('%d+%.%d+$')
        assert.same targets[running], require('howlscript.runtime')

      it 'raises an error for an unknown target', ->
        assert.raises "unknown target '5.1'", -> howlscript.to_lua('x = 1', target: '5.1')

  describe 'loadstring(source, chunkname, env)', ->
    it 'returns a function running the source', ->
      f = howlscript.loadstring('return ... + 1')
      assert.equals 3, f(2)

    it 'uses the chunk name in runtime errors', ->
      f = howlscript.loadstring('x = 1\nerror("boom")\nx', '=thing')
      _, err = pcall(f)
      assert.equals 'thing:2: boom', err

    it 'sets the environment when given', ->
      env = {x: 1}
      f = howlscript.loadstring('return x', nil, env)
      assert.equals 1, f()

    it 'returns nil and an error for invalid source', ->
      f, err = howlscript.loadstring('x = (', '=snippet')
      assert.is_nil f
      assert.match err, '^snippet:1:6:'

  describe 'loadfile(path, env) and dofile(path)', ->
    it 'load and run files, naming them by path', ->
      with_tmpfile 'x = ...\nerror("at #{x}")\nx', (path) ->
        f = howlscript.loadfile(path)
        _, err = pcall(f, 'two')
        assert.equals "#{path}:2: at two", err
        assert.raises 'at three', -> howlscript.dofile(path, 'three')

    it 'return nil and an error for missing files', ->
      f, err = howlscript.loadfile('/no/such/file.howl')
      assert.is_nil f
      assert.match err, 'No such file'

    it 'report compile errors with the path', ->
      with_tmpfile 'x = f 1', (path) ->
        _, err = howlscript.loadfile(path)
        assert.match err, '^' .. path:gsub('%p', '%%%0') .. ':1:7:'

  describe 'insert_loader() and remove_loader()', ->
    -- requires a module from the file at path, putting package.howlpath back after
    require_from = (path, name) ->
      howlpath = package.howlpath
      package.howlpath = path
      ok, result = pcall(require, name)
      package.howlpath = howlpath
      package.loaded[name] = nil
      ok, result

    -- the spec helper inserts the loader, which some of these take out
    after_each ->
      howlscript.insert_loader()

    it 'let require load Howlscript modules along package.howlpath', ->
      with_tmpfile "greeting = 'héllo'\n{:greeting}", (path) ->
        assert.same {true, {greeting: 'héllo'}}, {require_from(path, 'hs_spec_module')}

    it "report a module that doesn't compile, with its name and path", ->
      with_tmpfile 'x = f 1', (path) ->
        ok, err = require_from(path, 'hs_spec_bad')
        assert.is_false ok
        assert.match err, "^error loading module 'hs_spec_bad' from file '"
        assert.match err, ':1:7: '

    it 'take the loader out and put it back in, once each', ->
      assert.is_false howlscript.insert_loader()
      assert.is_true howlscript.remove_loader()
      assert.is_false howlscript.remove_loader()
      with_tmpfile '1', (path) ->
        ok, err = require_from(path, 'hs_spec_gone')
        assert.is_false ok
        assert.match err, "module 'hs_spec_gone' not found"
      assert.is_true howlscript.insert_loader()

    it "set package.howlpath from package.path unless it's set", ->
      lua_path, howlpath = package.path, package.howlpath
      howlscript.remove_loader()
      package.path, package.howlpath = './?.lua;/lib/?/init.lua', nil
      howlscript.insert_loader()
      derived = package.howlpath
      howlscript.remove_loader()
      package.howlpath = '/mine/?.howl'
      howlscript.insert_loader()
      kept = package.howlpath
      package.path, package.howlpath = lua_path, howlpath
      assert.same {'./?.howl;/lib/?/init.howl', '/mine/?.howl'}, {derived, kept}
