{:compile_error, :run} = require('spec.support')

describe 'loops', ->
  it 'support numeric for, with a step', ->
    assert.equals '1,3,5', run([[
      t = {}
      for i = 1, 6, 2
        t[#t + 1] = i
      table.concat(t, ',')
    ]])

  it 'support generic for', ->
    assert.equals 'a=1', run([[
      t = {}
      for k, v in pairs({a: 1})
        t[#t + 1] = "#{k}=#{v}"
      t[1]
    ]])

  it 'let the body assign the loop variables, also in Lua 5.5, which makes them constants', ->
    assert.same {60, 'a!'}, {run([[
      sum = 0
      for i = 1, 3
        i *= 10
        sum += i
      key = nil
      for k, v in pairs({a: 1})
        k ..= '!'
        key = k
      sum, key
    ]])}

  it 'iterate the values of a list with *', ->
    assert.equals 'abc', run([[
      s = ''
      for c in *{'a', 'b', 'c'}
        s ..= c
      s
    ]])

  it 'evaluate the list of a * loop once', ->
    assert.same {1, 3}, {run([[
      calls = 0
      list = ->
        calls += 1
        {1, 2, 3}
      n = 0
      for x in *list()
        n += 1
      calls, n
    ]])}

  it 'take the length of the list of a * loop once', ->
    assert.equals 3, run([[
      t = {1, 2, 3}
      n = 0
      for x in *t
        t[#t + 1] = x
        n += 1
      n
    ]])

  it 'iterate slices', ->
    assert.same {'b,c', 'a,c', 'c,b,a', 'b,c,d'}, {run([[
      items = {'a', 'b', 'c', 'd'}
      a, b, c, d = {}, {}, {}, {}
      a[#a + 1] = x for x in *items[2, 3]
      b[#b + 1] = x for x in *items[, 3, 2]
      c[#c + 1] = x for x in *items[3, 1, -1]
      d[#d + 1] = x for x in *items[2,]
      table.concat(a, ','), table.concat(b, ','), table.concat(c, ','), table.concat(d, ',')
    ]])}

  it 'count a negative slice stop from the end, as #list + stop', ->
    assert.same {'a,b,c', 'b', 'a,b', 'a,b', '', 2}, {run([[
      items = {'a', 'b', 'c', 'd'}
      calls = 0
      stop = (n) ->
        calls += 1
        n
      join = (t) -> table.concat(t, ',')
      a, b, c, d, e = {}, {}, {}, {}, {}
      a[#a + 1] = x for x in *items[1, -1]
      b[#b + 1] = x for x in *items[2, -2]
      c[#c + 1] = x for x in *items[1, stop(-2)]
      d[#d + 1] = x for x in *items[1, stop(2)]
      e[#e + 1] = x for x in *items[1, 0]
      join(a), join(b), join(c), join(d), join(e), calls
    ]])}

  it 'count a negative slice start from the end, starting -n at the n-th value from it', ->
    assert.same {'c,d', 'd', 'b,c', 'd,c,b,a', 'c,d', 'b,c,d', 2}, {run([[
      items = {'a', 'b', 'c', 'd'}
      calls = 0
      start = (n) ->
        calls += 1
        n
      join = (t) -> table.concat(t, ',')
      a, b, c, d, e, f = {}, {}, {}, {}, {}, {}
      a[#a + 1] = x for x in *items[-2,]
      b[#b + 1] = x for x in *items[-1,]
      c[#c + 1] = x for x in *items[-3, -1]
      d[#d + 1] = x for x in *items[-1, 1, -1]
      e[#e + 1] = x for x in *items[start(-2),]
      f[#f + 1] = x for x in *items[start(2),]
      join(a), join(b), join(c), join(d), join(e), join(f), calls
    ]])}

  it 'reject a negative step without both a start and a stop', ->
    err = compile_error("for x in *t['é',,-1] do print(x)")
    assert.match err, 'a negative step needs a start and a stop, as in %*t%[%-1, 1, %-1%]'
    assert.match err, '^spec:1:18:'
    assert.match compile_error('for x in *t[,,-2] do print(x)'), 'a negative step needs a start and a stop'
    assert.match compile_error('for x in *t[,1,-1] do print(x)'), 'a negative step needs a start and a stop'
    assert.same {'c', 'b'}, run('[x for x in *{"a", "b", "c"}[3, 2, -1]]')

  it 'reject slices outside of loops', ->
    assert.match compile_error('x = t[1, 2]'), 'slices can only be used in loops'

  it 'support while', ->
    assert.equals 0, run([[
      i = 3
      while i > 0
        i--
      i
    ]])

  it 'support single line bodies with do', ->
    assert.same {6, 3}, {run([[
      sum = 0
      for i = 1, 3 do sum += i
      n = 0
      while n < 3 do n++
      sum, n
    ]])}

  it 'support break', ->
    assert.equals 3, run([[
      last = nil
      for i = 1, 10
        last = i
        break if i == 3
      last
    ]])

  describe 'continue', ->
    it 'skips to the next iteration', ->
      assert.equals '1,3,5', run([[
        t = {}
        for i = 1, 6
          continue if i % 2 == 0
          t[#t + 1] = i
        table.concat(t, ',')
      ]])

    it 'jumps past locals declared after it', ->
      assert.equals '2,4', run([[
        t = {}
        for x in *{1, 2, 3, 4}
          continue unless x % 2 == 0
          y = x
          t[#t + 1] = y
        table.concat(t, ',')
      ]])

    it 'works in while loops and with a return ending the body', ->
      assert.equals 3, run([[
        f = ->
          i = 0
          while true
            i++
            continue if i < 3
            return i
        f()
      ]])

    it 'applies to the innermost loop', ->
      assert.equals 6, run([[
        n = 0
        for i = 1, 3
          for j = 1, 3
            continue if j == 2
            n += 1
          continue
        n
      ]])

    it 'is an error outside of loops', ->
      assert.match compile_error('continue'), "'continue' outside of a loop"
      assert.match compile_error('break'), "'break' outside of a loop"

  describe 'have no value', ->
    it 'so they are errors where a value is expected', ->
      for src in *{'x = for i = 1, 2 do i', 'x = while c do f()', 'return for x in *t do x', 'f(for x in *t do x)'}
        assert.match compile_error(src), 'is a statement and gives no value; collect values with a comprehension'

    it 'so a function ending in one returns nothing', ->
      assert.equals 0, run([[
        f = -> for i = 1, 2 do tostring(i)
        select('#', f())
      ]])

  it 'reject loop variables shadowing locals', ->
    assert.match compile_error('i = 1\nfor i = 1, 2 do print(i)'), "loop variable 'i' shadows the local declared on line 1"
    assert.match compile_error('x = 1\nfor x in *t do print(x)'), "loop variable 'x' shadows"
    assert.match compile_error('k = 1\nfor k, v in pairs(t) do print(k)'), "loop variable 'k' shadows"

  it 'reject updating a new name, which would be a local of each iteration', ->
    err = compile_error([[
      s = 'é'
      for x in *items
        total += x
    ]])
    assert.match err, "^spec:3:3: 'total' would be a new local of each iteration, gone after it; give it a value before the loop"
    assert.match compile_error('while busy()\n  if ready()\n    n++'), "'n' would be a new local of each iteration"
    assert.match compile_error('for i = 1, 2\n  for j = 1, 2\n    n *= j'), "'n' would be a new local of each iteration"

  it 'let functions in the body update new names, as locals of each call', ->
    assert.is_nil compile_error([[
      for i = 1, 2
        f = -> n += 1
    ]])

  it 'allow _ to be reused', ->
    assert.equals 2, run([[
      n = 0
      for _, a in ipairs({1})
        for _, b in ipairs({1, 2})
          n = b
      n
    ]])

  describe 'as statement modifiers', ->
    it 'run a statement for each value', ->
      assert.equals 6, run([[
        sum = 0
        sum += x for x in *{1, 2, 3}
        sum
      ]])

    it 'end a one-line function in keyed entries, call arguments and parentheses', ->
      assert.same {3, 3, 3}, {run([[
        total = 0
        box = {add: (t) -> total += x for x in *t}
        box.add({1, 2})
        a = total
        call = (f) -> f({1, 2})
        call((t) -> total += x for x in *t)
        b = total - a
        g = ((t) -> total += x for x in *t)
        g({1, 2})
        a, b, total - a - b
      ]])}

    it 'filter with if and unless', ->
      assert.same {4, 5}, {run([[
        a, b = 0, 0
        a += x for x in *{1, 2, 3} if x != 2
        b += x for x in *{1, 2, 3} unless x == 1
        a, b
      ]])}
      assert.match compile_error('print(x) for x in *t when x'), "filter with 'if' or 'unless' rather than 'when'"

    it 'reject declaring a name, which would be a local of each iteration', ->
      err = compile_error("s = 'é'\nlast = x for x in *items")
      assert.match err, "'last' would be a new local of each iteration, gone after it; declare it before the loop with 'local last'"
      assert.match err, '^spec:2:1:'
      assert.match compile_error('total += x for x in *items'), "'total' would be a new local of each iteration, gone after it; give it a value before the loop"
      assert.match compile_error('last = x for x in *items if x'), "'last' would be a new local"
      assert.match compile_error('a, {b} = x, x for x in *items'), "'a' would be a new local"
      assert.match compile_error('{b} = x for x in *items'), "'b' would be a new local"

    it 'assign existing locals, fields and loop variables', ->
      assert.same {3, {true, true, true}, {2, 4, 6}}, {run([[
        local last
        seen, items = {}, {1, 2, 3}
        last = x for x in *items
        seen[x] = true for x in *items
        doubled = [x for x in *items]
        doubled[i] = x * 2 for i, x in ipairs(doubled)
        last, seen, doubled
      ]])}
