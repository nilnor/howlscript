{:compile, :compile_error, :run} = require('spec.support')

describe 'assignment', ->
  it 'declares a local on the first assignment to a name', ->
    assert.match compile('x = 1'), '^local x = 1'
    env = {}
    run('x = 1', env)
    assert.is_nil rawget(env, 'x')

  it 'assigns to a visible local instead of declaring a new one', ->
    assert.equals 3, run([[
      x = 1
      f = -> x = 3
      f()
      x
    ]])

  it 'declares only the new names in a multiple assignment', ->
    lua = compile([[
      a = 1
      a, b = 2, 3
    ]])
    assert.match lua, 'local b; a, b = 2, 3'
    assert.same {2, 3}, {run([[
      a = 1
      a, b = 2, 3
      a, b
    ]])}

  it 'spreads the values of a last call over the targets, and truncates others', ->
    assert.same {1, 2, 3, nil, 1, 10, nil}, {run([[
      f = -> 1, 2, 3
      a, b, c, d = f()
      e, g, h = f(), 10
      a, b, c, d, e, g, h
    ]])}

  it 'swaps values', ->
    assert.same {2, 1, {a: 2, b: 1}}, {run([[
      a, b = 1, 2
      a, b = b, a
      t = {a: 1, b: 2}
      t.a, t.b = t.b, t.a
      a, b, t
    ]])}

  describe 'visibility of a new name', ->
    it 'starts after its statement', ->
      -- `x` on the right is the global, not the new local
      env = {x: 'global'}
      assert.equals 'global', run('x = x\nx', env)
      assert.match compile('x = x'), '^local x = x'

    it 'includes its own value when that is a function, which can then recurse', ->
      assert.same {120, true, true}, {run([[
        fact = (n) -> n <= 1 and 1 or n * fact(n - 1)
        p, q = 1, -> q
        fact(5), q() == q, p == 1
      ]])}

    it 'includes its own value when that is a with block or a comprehension', ->
      assert.same {true, true}, {run([[
        obj = with {}
          .get = -> obj
        list = [(-> list) for i = 1, 2]
        obj.get() == obj, list[1]() == list
      ]])}

    it 'does not include tables and parenthesized functions', ->
      env = {t: 'global t', d: 'global d'}
      assert.same {'global t', 'global d'}, {run([[
        t = {get: -> t}
        d = (-> d)
        t.get(), d()
      ]], env)}

    it 'leaves parameters and loop variables free to use the name', ->
      assert.same {3, {'a', 'b'}}, {run([[
        f = (f) -> f
        names = [names for names in *{'a', 'b'}]
        f(3), names
      ]])}

    it 'rejects reading the new name in its own value outside a function, where it is still nil', ->
      err = compile_error("s = 'é'\ntostring, g = tostring, -> s")
      assert.match err, "'tostring' is read in its own value, where it's the new local and still nil; assign it in a statement of its own, or rename"
      assert.match err, '^spec:2:15:'
      assert.match compile_error('arg = [a for a in *arg]'), "'arg' is read in its own value"
      assert.match compile_error('t = {k, t for k in *t}'), "'t' is read in its own value"
      assert.match compile_error('string = with string\n  .x = 1'), "'string' is read in its own value"
      assert.match compile_error('x = with {}\n  .y = x'), "'x' is read in its own value"
      assert.match compile_error('x = with {}\n  x.y = 1'), "'x' is read in its own value"
      -- a comprehension inside the with block runs at once too
      assert.match compile_error('x = with {}\n  .n = #[v for v in *x]'), "'x' is read in its own value"
      -- a default runs when the function is called, by which time the name is set
      assert.equals 'f', run([[
        f = (x = f) -> x
        f() == f and 'f'
      ]])

    it 'does not include the value of a local statement, as in Lua', ->
      assert.equals 'outer', run([[
        f = -> 'outer'
        g = ->
          local f = -> f()
          f()
        g()
      ]])

  describe 'with more values than targets', ->
    it 'is an error, as Lua would drop the extra values', ->
      err = compile_error("x = 'é', 2")
      assert.match err, '2 values for 1 target; the values after the first would be dropped'
      assert.match err, '^spec:1:10:'
      assert.match compile_error('a, b = 1, 2, f()'), '3 values for 2 targets; the values after the first 2 would be dropped'
      assert.match compile_error('local a = 1, 2'), '2 values for 1 target'
      assert.match compile_error('t.x = 1, 2'), '2 values for 1 target'

    it 'explains that a call with a table after it takes only the table', ->
      assert.match compile_error('x = f {a}, b'), 'as a call with a table after it takes only the table; to pass more, write f%({...}, b%)'
      assert.not_match compile_error('x = f({a}), b'), 'takes only the table'

    it 'leaves fewer values than targets to Lua, which sets the rest to nil', ->
      assert.same {1, 2, nil}, {run([[
        pair = -> 1, 2
        a, b, c = pair()
        a, b, c
      ]])}

  it 'assigns to fields, indexes and self', ->
    assert.same {a: 1, [2]: 'two'}, run([[
      t = {}
      t.a = 1
      t[1 + 1] = 'two'
      t
    ]])

  describe 'update operators', ->
    it 'supports all the operators', ->
      assert.same {11, 4, 6, 2.5, 1, 'ab', 'x', false}, {run([[
        a, b, c, d, e, f, g, h = 1, 6, 3, 5, 7, 'a', nil, true
        a += 10
        b -= 2
        c *= 2
        d /= 2
        e %= 3
        f ..= 'b'
        g or= 'x'
        h and= false
        a, b, c, d, e, f, g, h
      ]])}
      assert.same {8, 13, 12, 1, 3}, {run([[
        a, b, c, d, e = 12, 12, 3, 3, 7
        a &= 10
        b |= 1
        c <<= 2
        d >>= 1
        e //= 2
        a, b, c, d, e
      ]])}
      -- the right-hand side is a whole operand: 2 ^ (1 + 2), and 2 ^ (3 ^ 2)
      assert.same {9, 8, 512}, {run([[
        a, b, c = 3, 2, 2
        a ^= 2
        b ^= 1 + 2
        c ^= 3 ^ 2
        a, b, c
      ]])}

    it 'have no xor update, as ~= compares', ->
      assert.match compile_error('x = 1\nx ~= 2\ny = x'), '2:1: this expression does nothing'

    it 'parenthesizes the right-hand side', ->
      assert.equals 1, run([[
        x = 10
        x -= 4 + 5
        x
      ]])

    it 'evaluates a complex target only once', ->
      assert.same {1, 2}, {run([[
        calls = 0
        t = {{n: 1}}
        get = ->
          calls += 1
          t[1]
        get().n += 1
        calls, t[1].n
      ]])}

    it 'declare a local when the name is new, reading the global', ->
      assert.match compile('y or= 3'), '^local y = y or 3'
      env = {count: 1}
      assert.same {2, 1}, {run([[
        f = ->
          count += 1
          count
        f()
      ]], env), env.count}

    it 'evaluates a complex index only once', ->
      assert.same {1, 5}, {run([[
        calls = 0
        t = {4}
        key = ->
          calls += 1
          1
        t[key()] += 1
        calls, t[1]
      ]])}

  describe '++ and --', ->
    it 'increment and decrement', ->
      assert.same {2, 0, 11}, {run([[
        a, b = 1, 1
        t = {n: 10}
        a++
        b--
        t.n++
        a, b, t.n
      ]])}

    it 'only follow a name, so not an index, which takes += 1', ->
      err = compile_error("s = 'é'\nt[1]++")
      assert.match err, "'%+%+' only follows a name; write %+= 1 here"
      assert.match err, '^spec:2:5:'
      -- -- after ] is an error, not a comment, which would make this return t[i]
      assert.match compile_error('dec = (t, i) -> t[i]--'), "'%-%-' only follows a name; write %-= 1 here"
      assert.equals 4, run([[
        t = {3}
        t[1] += 1
        t[1]
      ]])

    it 'are statements, not expressions', ->
      assert.not_nil compile_error('y = x++')

  it 'evaluate a value assigned to _, keeping a read for its effect', ->
    assert.same {'a', 'b'}, run([[
      reads = {}
      t = setmetatable({}, {__index: (k) => reads[#reads + 1] = k})
      _ = t.a
      _ = t.b
      reads
    ]])

  describe 'local', ->
    it 'forward declares names', ->
      assert.equals 'odd', run([[
        local is_even, is_odd
        is_even = (n) -> n == 0 and 'even' or is_odd(n - 1)
        is_odd = (n) -> n == 0 and 'odd' or is_even(n - 1)
        is_even(3)
      ]])

    it 'can shadow a local explicitly', ->
      assert.equals 1, run([[
        x = 1
        f = ->
          local x = 2
          x
        f()
        x
      ]])

  describe '<const>', ->
    it 'declares a local that later assignments may not change', ->
      assert.equals 10, run('max <const> = 10\nmax')
      assert.match compile('max <const> = 10'), '^local max = 10$'
      err = compile_error("s = 'é'\nmax <const> = 10\nmax = 11")
      assert.match err, "'max' is a constant, declared with <const> on line 2"
      assert.match err, '^spec:3:1:'
      for src in *{'max += 1', 'max++', 'f = -> max = 2', '{max} = t', 'max, y = 1, 2'}
        assert.match compile_error("max <const> = 10\n#{src}"), "'max' is a constant"

    it 'goes after any of the names an assignment declares, and in local', ->
      assert.match compile_error('a, b <const> = 1, 2\nb = 3'), "'b' is a constant"
      assert.equals 3, run('a, b <const> = 1, 2\na = 3\na')
      assert.match compile_error('local max <const> = 3\nmax = 1'), "'max' is a constant"

    it 'follows the rules of other assignments, so a function can call itself', ->
      assert.equals 120, run('fact <const> = (n) -> n <= 1 and 1 or n * fact(n - 1)\nfact(5)')
      assert.match compile_error('f <const> = -> f = nil'), "'f' is a constant"

    it 'must declare the names, which a local may shadow', ->
      assert.match compile_error('x = 1\nx <const> = 2'), "'x' is already a local, so this doesn't declare it"
      assert.equals 2, run([[
        max <const> = 1
        f = ->
          local max = 2
          max
        f()
      ]])

    it "can't have an if after it, which would declare a constant without a value", ->
      assert.match compile_error('x <const> = 1 if c'), "can't have an 'if' or 'unless' after it"

    it 'leaves const and close ordinary names elsewhere', ->
      assert.same {1, 2, true}, {run([[
        close, const = 1, 2
        close, const, close < const
      ]])}

  describe '<close>', ->
    runtime = require('howlscript.runtime')

    it "calls the value's __close when the local goes out of scope, also on an error", ->
      unless runtime.close
        assert.match compile_error('lock <close> = f()'), "'<close>' needs Lua 5.4 or later"
        return
      assert.same {'saved', false, 'saving, closed, saving, closed after an error'}, {run([[
        log = {}
        closer = setmetatable({}, __close: (err) => log[#log + 1] = err and 'closed after an error' or 'closed')
        save = (fail) ->
          lock <close> = closer
          log[#log + 1] = 'saving'
          error('disk full') if fail
          'saved'
        r = save(false)
        ok = pcall(save, true)
        r, ok, table.concat(log, ', ')
      ]])}

    it 'takes the value of a with block', ->
      return unless runtime.close
      assert.equals 'closed 1', run([[
        log = nil
        f = ->
          res <close> = with setmetatable({}, __close: => log = "closed #{@n}")
            .n = 1
          res.n
        f()
        log
      ]])

    it 'is an error for a Lua without it, and for two names of a statement', ->
      howlscript = require('howlscript')
      for target in *{'luajit', 'luajit-2026', '5.2', '5.3', 'portable'}
        _, err = howlscript.to_lua('lock <close> = f()', :target)
        assert.match err, "'<close>' needs Lua 5.4 or later, and this compiles for a Lua without it"
      assert.match howlscript.to_lua('lock <close> = f()', target: '5.4'), '^local lock <close> = f%(%)$'
      assert.match howlscript.to_lua('local a, lock <close> = 1, f()', target: '5.4'), '^local a, lock <close> = 1, f%(%)$'
      _, err = howlscript.to_lua('local lock <close> = f()', target: 'luajit')
      assert.match err, "'<close>' needs Lua 5.4 or later"
      _, err = howlscript.to_lua('a <close>, b <close> = f()', target: '5.5')
      assert.match err, "only one name of a statement can be '<close>', as in Lua"

    it 'is a constant', ->
      _, err = require('howlscript').to_lua('lock <close> = f()\nlock = nil', target: '5.4')
      assert.match err, "'lock' is a constant, declared with <close> on line 1"

  it 'assigns globals only through _G, as a new name declares a local', ->
    env = {}
    env._G = env
    run([[
      _G.a = 1
      b = 2
      f = -> _G.c = 3
      f()
    ]], env)
    assert.same {1, 3}, {env.a, env.c}
    assert.is_nil rawget(env, 'b')

  it 'treats import, from, using, extends and export as ordinary names', ->
    assert.same {1, 2, 3, 4, 5}, {run([[
      import, from, using, extends, export = 1, 2, 3, 4, 5
      import, from, using, extends, export
    ]])}
    -- MoonScript's import is a call without parentheses here, with b from t nested
    assert.match compile_error('import a, b from t'), 'a call in the arguments of a call without parentheses'
    -- and its export a call whose result can't be assigned to
    assert.match compile_error('export x = 1'), "can't assign to the result of a call"

  it 'rejects Lua keywords as names', ->
    assert.match compile_error('end = 1'), "'end' is a Lua keyword"
    assert.match compile_error('x = function'), "'function' is a Lua keyword"

  it 'rejects assignment to calls', ->
    assert.match compile_error('f() = 1'), "can't assign to the result of a call"
