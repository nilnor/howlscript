{:compile, :compile_error, :run} = require('spec.support')

describe 'comprehensions', ->
  describe 'list comprehensions', ->
    it 'map lists', ->
      assert.same {2, 4, 6}, run('[x * 2 for x in *{1, 2, 3}]')

    it 'filter with if and unless', ->
      assert.same {{2}, {1, 3}}, {run([[
        [x for x in *{1, 2, 3} if x % 2 == 0], [x for x in *{1, 2, 3} unless x == 2]
      ]])}

    it 'reject when as a filter, and an if before the for', ->
      assert.match compile_error('r = [x for x in *t when x > 1]'), "filter with 'if' or 'unless' rather than 'when'"
      assert.match compile_error('r = [x if x > 1 for x in *t]'), "a comprehension's 'if' goes after its 'for'"

    it 'take a single for and a single filter', ->
      assert.match compile_error('r = [{x, y} for x in *xs for y in *ys]'), "a comprehension takes a single 'for'; go over several with nested for loops"
      assert.match compile_error('r = [x for x in *t if a if b]'), "a comprehension takes a single filter; combine the conditions with 'and'"
      assert.match compile_error('r = [x for x in *t if a unless b]'), 'a comprehension takes a single filter'

    it 'support slices and destructuring', ->
      assert.same {{2, 3}, {3, 7}}, {run('        items = {1, 2, 3, 4}
        [x for x in *items[2, 3]], [a + b for {a, b} in *{{1, 2}, {3, 4}}]
      ')}

    it 'support numeric and generic for', ->
      assert.same {{2, 4}, {'a'}}, {run([[
        [i for i = 2, 4, 2], [k for k in pairs({a: 1})]
      ]])}

    it 'let functions assign the loop variables, also in Lua 5.5, which makes them constants', ->
      assert.equals 'a!', run([[
        cells = [{set: (-> k ..= '!'), get: -> k} for k in pairs({a: 1})]
        cells[1].set()
        cells[1].get()
      ]])

    it 'can be arguments', ->
      assert.equals '1-2', run("table.concat([x for x in *{1, 2}], '-')")

    it 'can span lines', ->
      assert.same {1, 3}, run([[
        [x for x in *{1, 2, 3}
          if x != 2]
      ]])

    it 'take a function in parentheses', ->
      assert.equals 2, run([[
        fs = [(-> x) for x in *{1, 2}]
        fs[2]()
      ]])

    it 'reject a one-line function directly followed by the for, as unclear', ->
      for src in *{'fs = [-> x for x in *t]', 't = {(v) -> f(v) for v in *t}'}
        assert.match compile_error(src), "a one%-line function followed by 'for' is unclear here; .* %[%(%-> x%) for x in %*t%]"

    it 'need a for clause', ->
      assert.match compile_error('x = [1, 2]'), "expected 'for'"

  describe 'table comprehensions', ->
    it 'build tables from keys and values', ->
      assert.same {a: 'A', b: 'B'}, run([[
        {k, k:upper() for k in *{'a', 'b'}}
      ]])

    it 'take a single for', ->
      assert.match compile_error("t = {x .. y, true for x in *xs for y in *ys}"), "a comprehension takes a single 'for'"

    it 'filter with if and unless', ->
      assert.same {{name: 'fast'}, {color: 'red'}}, {run([[
        thing = {color: 'red', name: 'fast'}
        {k, v for k, v in pairs(thing) if k != 'color'}, {k, v for k, v in pairs(thing) unless k == 'name'}
      ]])}

    it 'take the key and value from a single expression', ->
      assert.same {hello: 'world', foo: 'bar'}, run([[
        pair = (t) -> t[1], t[2]
        {pair(t) for t in *{{'hello', 'world'}, {'foo', 'bar'}}}
      ]])
      assert.same {{a: '1'}, {b: 2}}, {run([[
        f = (...) -> {... for _ = 1, 1}
        {s:match('(%a)=(%d)') for s in *{'a=1'}}, f('b', 2)
      ]])}

    it 'reject a single expression giving a single value, as it would set nothing', ->
      err = compile_error('t = {x for x in *xs}')
      assert.match err, '1:6: a table comprehension.s one expression gives the key and the value, but this one gives a single value'
      assert.match err, 'write {k, v for ...}, or %[x for ...%] for a list'
      for src in *{'{x.name for x in *xs}', '{(f(x)) for x in *xs}', '{[y for y in *x] for x in *xs}'}
        assert.match compile_error('t = ' .. src), 'gives a single value'

  describe 'inside expressions', ->
    it 'are computed before the statement rather than in a function called in place', ->
      lua = compile([[
        print(#[x for x in *t])
        total = 0
        total += count([x for x in *t])
        n = f(a, [x for x in *t])
        g = -> obj:sum([x for x in *t])
        nested = [ [y for y in *x] for x in *t]
      ]])
      assert.is_nil lua:find('(function(', 1, true)

    it 'keep the order of evaluation', ->
      assert.same {'3 3', '2 2', 'a,b,c,inc,inc,d'}, {run([[
        log = {}
        add = (s) -> log[#log + 1] = s
        count = 0
        inc = ->
          add('inc')
          count += 1
          count
        f = (a, b, t) -> "#{a} #{b + #t}"
        add('a')
        obj = {m: (x, t) => add('d') or f(x, 1, t)}
        r = f(count + 3, add('b') or 2, [(add('c') or inc()) for i = 1, 1])
        r2 = obj:m(count + 1, [inc() for i = 1, 1])
        r, r2, table.concat(log, ',')
      ]])}

    it 'give the same values in calls, returns, assignments, updates and methods', ->
      assert.same {3, 4, 2, 6, 2, {{2}, {4, 6}}}, {run([[
        t = {1, 2, 3}
        count = (l) -> #l
        a = count([x for x in *t])
        b = 1
        b += count([x for x in *t])
        f = -> count([x for x in *t if x > 1])
        obj = {sum: (l) => #l * 2}
        g = -> obj:sum([x for x in *t])
        d = count({[x for x in *t], 1})
        nested = [ [y * 2 for y in *x] for x in *{{1}, {2, 3}}]
        a, b, f(), g(), d, nested
      ]])}

    it 'assign the names read before them, not copies of them', ->
      assert.same {3, 5}, {run([[
        t = {1, 2}
        count = (a, l) -> a + #l
        c = 1
        c = count(c, [x for x in *t])
        d = 3
        d += count(0, [x for x in *t])
        c, d
      ]])}

    it 'stay functions on the right of and and or, evaluated only then', ->
      assert.same {false, 2, 2}, {run([[
        n = 0
        bump = ->
          n += 1
          n
        a = false and #[bump() for i = 1, 3]
        b = #[x for x in *{1}] == 1 and #[bump() for i = 1, 2]
        a, b, n
      ]])}
      assert.match compile('x = a and f([y for y in *t])'), 'function%('

    it 'stay functions when they span lines', ->
      assert.match compile('x = f([y for y in *t\n  if y])'), 'function%('

    it 'read what a name assigned by the statement was', ->
      assert.equals 2, run([[
        xs = #[x for x in *xs]
        xs
      ]], {xs: {1, 2}})

    it "leave the statement on its line, and Lua's errors naming what was called", ->
      -- the source's first line break is dropped, which leaves the call on line 3
      err = select(2, pcall(run, '\n\nf = nil\nf([x for x in *{1}])'))
      assert.match err, "^spec:3: attempt to call .*'f'"

    it 'scope their locals, so a goto can jump past them', ->
      assert.equals 'done', run([[
        f = -> 'done'
        for i = 1, 2
          goto skip if i == 1
          print(#[x for x in *{1}])
          ::skip::
          f()
        f()
      ]])

  it 'reject comprehension variables shadowing locals', ->
    assert.match compile_error('x = 1\ny = [x for x in *t]'), "loop variable 'x' shadows"

  it 'are not a statement on their own', ->
    assert.match compile_error('[x for x in *t]\nprint(1)'), 'this comprehension does nothing'
