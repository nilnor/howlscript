{:compile_error, :run} = require('spec.support')

describe 'switch', ->
  name_of = (n) ->
    run([[
      switch ...
        when 'Robert'
          return 'robert'
        when 'Dan', 'Daniel'
          return 'dan'
        else
          return 'unknown'
    ]], {}, n)

  it 'picks the first matching when, comparing with ==', ->
    assert.same {'robert', 'dan', 'dan', 'unknown'}, {name_of('Robert'), name_of('Dan'), name_of('Daniel'), name_of('x')}

  it 'supports when ... then and else on one line', ->
    assert.same {'two', 'other'}, {run([[
      f = (x) ->
        switch x
          when 1 then return 'one'
          when 2 then return 'two'
          else return 'other'
      f(2), f(3)
    ]])}

  it 'evaluates the subject once', ->
    assert.same {1, 'b'}, {run([[
      calls = 0
      subject = ->
        calls += 1
        2
      local r
      switch subject()
        when 1 then r = 'a'
        when 2 then r = 'b'
      calls, r
    ]])}

  it 'tests the values in order, up to the first match', ->
    assert.same {'one', '1'}, {run([[
      log = {}
      v = (n) ->
        log[#log + 1] = n
        n
      local r
      switch 1
        when v(1), v(2) then r = 'one'
        when v(3) then r = 'three'
      r, table.concat(log, ',')
    ]])}

  it 'puts the case value on the left of ==', ->
    assert.equals 'when value on the left', run([[
      mt = {__eq: (a, b) -> a.id == 'when'}
      case = setmetatable({id: 'when'}, mt)
      local r
      switch setmetatable({id: 'subject'}, mt)
        when case then r = 'when value on the left'
        else r = 'subject on the left'
      r
    ]])

  it 'rejects and and or after a literal, which compare a single value', ->
    err = compile_error([[
      s = 'é'
      switch s
        when 'if' or 'unless' then print(1)
    ]])
    assert.match err, "^spec:3:13: 'or' after a literal always gives the same side, so this compares a single value; to match several, separate them with commas, as in when 'a', 'b'"
    assert.match compile_error("switch s\n  when 1, 'a' or 'b' or 'c' then f()"), "^spec:2:15: 'or' after a literal"
    assert.match compile_error("switch s\n  when nil and x then f()"), "'and' after a literal"

  it 'allows and and or after other expressions', ->
    assert.same {'default', 'b'}, {run([[
      opts, x = {}, false
      local r1, r2
      switch 'normal'
        when opts.mode or 'normal' then r1 = 'default'
      switch 'b'
        when x and 'a' or 'b' then r2 = 'b'
      r1, r2
    ]])}

  it 'has no value', ->
    assert.match compile_error('x = switch y\n  when 1 then 2'), "'switch' is a statement and gives no value"
    assert.match compile_error('f = (y) ->\n  switch y\n    when 1 then 2'), 'this expression does nothing'

  it 'ends a function returning nothing, unless a case returns', ->
    assert.same {'one', 0, 0}, {run([[
      f = (y) ->
        switch y
          when 1 then return 'one'
          when 2 then tostring(y)
      f(1), select('#', f(2)), select('#', f(3))
    ]])}

  it 'needs when clauses', ->
    assert.match compile_error('switch x\nprint(1)'), "expected 'when' clauses"
