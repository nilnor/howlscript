#! /bin/sh
#
# Copyright 2026 Nils Nordman
# License: MIT (see LICENSE.md at the top-level directory of the distribution)
#
# Builds the Lua versions Howlscript supports into .lua/<version>, each with its own
# LuaRocks and the rocks the specs need. Given versions, as in `setup-lua luajit 5.4`,
# builds only those. What's already built is kept, so it can be rerun to finish an
# interrupted setup.

set -eu

ROOT=$(cd "$(dirname "$0")/.." && pwd)
DEST=$ROOT/.lua
SOURCES=$DEST/sources

VERSIONS='luajit 5.2 5.3 5.4 5.5'
LUAJIT_COMMIT=63c8f1a9b479ba5518cf6a170ff7729178bc3cfd
LUAROCKS=3.13.0
LUAROCKS_SHA256=245bf6ec560c042cb8948e3d661189292587c5949104677f1eecddc54dbe7e37

# The release of each Lua series, and its SHA-256
lua_release() {
  case $1 in
    5.2) echo 5.2.4 b9e2e4aad6789b3b63a056d442f7b39f0ecfca3ae0f1fc0ae4e9614401b69f4b ;;
    5.3) echo 5.3.6 fc5fd69bb8736323f026672b1b7235da613d7177e72558893a0bdcd320466d60 ;;
    5.4) echo 5.4.9 2335b6c582a52654f94612bf10d2f4672805d05329aa6568b1d8cd9e5c6fb8e6 ;;
    5.5) echo 5.5.1 1c4b4068d67061f2a2231ad2b5422e77acea1487ea9890f6320af614f4373dce ;;
  esac
}

case $(uname) in
  Darwin) PLAT=macosx ;;
  *) PLAT=linux ;;
esac

fail() {
  echo "setup-lua: $*" >&2
  exit 1
}

# Runs a command with its output going to the log, showing the log's end on failure
quietly() {
  if ! "$@" >>"$LOG" 2>&1; then
    tail -n 30 "$LOG" >&2
    fail "failed: $* (full log in $LOG)"
  fi
}

sha256() {
  if command -v sha256sum >/dev/null; then
    sha256sum "$1" | cut -d ' ' -f 1
  else
    shasum -a 256 "$1" | cut -d ' ' -f 1
  fi
}

# Downloads a URL into the sources unless it's there, and checks its SHA-256
fetch() {
  file=$SOURCES/$(basename "$1")
  if [ ! -f "$file" ]; then
    quietly curl -sSfL --connect-timeout 20 --retry 3 "$1" -o "$file.part"
    mv "$file.part" "$file"
  fi
  if [ "$(sha256 "$file")" != "$2" ]; then
    rm -f "$file"
    fail "$1 doesn't have the expected SHA-256"
  fi
}

# Unpacks a fetched tarball into a fresh build directory, printing its path
unpack() {
  rm -rf "$BUILD"
  mkdir -p "$BUILD"
  tar -xzf "$SOURCES/$1" -C "$BUILD"
  echo "$BUILD/${1%.tar.gz}"
}

build_puc() {
  set -- "$1" $(lua_release "$1")
  fetch "https://www.lua.org/ftp/lua-$2.tar.gz" "$3"
  dir=$(unpack "lua-$2.tar.gz")
  quietly make -C "$dir" "$PLAT"
  quietly make -C "$dir" install INSTALL_TOP="$PREFIX"
}

build_luajit() {
  src=$SOURCES/LuaJIT
  [ -d "$src" ] || quietly git clone https://github.com/LuaJIT/LuaJIT "$src"
  (cd "$src" && git cat-file -e "$LUAJIT_COMMIT^{commit}" 2>/dev/null) || (cd "$src" && quietly git fetch origin)
  rm -rf "$BUILD"
  quietly git clone --no-checkout "$src" "$BUILD/LuaJIT"
  (cd "$BUILD/LuaJIT" && quietly git checkout "$LUAJIT_COMMIT")
  quietly make -C "$BUILD/LuaJIT" PREFIX="$PREFIX"
  quietly make -C "$BUILD/LuaJIT" install PREFIX="$PREFIX"
  ln -sf luajit "$PREFIX/bin/lua"
}

build_luarocks() {
  fetch "https://luarocks.github.io/luarocks/releases/luarocks-$LUAROCKS.tar.gz" "$LUAROCKS_SHA256"
  dir=$(unpack "luarocks-$LUAROCKS.tar.gz")
  if [ "$1" = luajit ]; then
    set -- --with-lua-include="$PREFIX/include/luajit-2.1" --with-lua-interpreter=luajit
  else
    set -- --with-lua-include="$PREFIX/include"
  fi
  (cd "$dir" && quietly ./configure --prefix="$PREFIX" --with-lua="$PREFIX" "$@")
  quietly make -C "$dir"
  quietly make -C "$dir" install
}

setup() {
  PREFIX=$DEST/$1
  BUILD=$DEST/build/$1
  LOG=$DEST/logs/$1.log
  : >"$LOG"

  if [ ! -x "$PREFIX/bin/lua" ]; then
    echo "$1: building Lua"
    if [ "$1" = luajit ]; then build_luajit; else build_puc "$1"; fi
  fi

  if [ ! -x "$PREFIX/bin/luarocks" ]; then
    echo "$1: building LuaRocks"
    build_luarocks "$1"
  fi

  echo "$1: installing the rockspec's test dependencies"
  (cd "$ROOT" && quietly "$PREFIX/bin/luarocks" test --prepare howlscript-scm-1.rockspec)

  rm -rf "$BUILD"
  echo "$1: done, in $PREFIX"
}

[ $# -gt 0 ] || set -- $VERSIONS
for version in "$@"; do
  case " $VERSIONS " in
    *" $version "*) ;;
    *) fail "unknown version '$version' (supported: $VERSIONS)" ;;
  esac
done

mkdir -p "$SOURCES" "$DEST/logs"
for version in "$@"; do
  setup "$version"
done
