#! /bin/sh
#
# Copyright 2026 Nils Nordman
# License: MIT (see LICENSE.md at the top-level directory of the distribution)
#
# Builds the website into site/public with Zola, which scripts/setup-zola fetches.
# `site serve` serves it on http://127.0.0.1:1111 instead, rebuilding on changes,
# and `site check` checks its links. Further arguments go to Zola, as in
# `site build --base-url https://example.org`.
#
# `site deploy` builds it and syncs it to the S3 bucket behind howlscript.io, with
# the AWS CLI, deleting what the build no longer has. Cloudflare and browsers keep
# the pages an hour, the 404 page a minute, and the files the pages link by hash,
# copied to hashed/<hash>/, a year; those go up first and stay. It
# uses the AWS profile `howlscript` unless AWS_PROFILE names another. Further
# arguments go to the AWS CLI, as in `site deploy --dryrun`.
#
# The reference and converting pages are made from REFERENCE.md and CONVERTING.md
# each time this runs, so `serve` doesn't pick up changes to those. The manual's
# pages are made from site/manual by scripts/make-manual.lua, which adds the Lua of
# each example, compiled with the checkout's Howlscript and laid out by StyLua
# (scripts/setup-stylua fetches it). `serve` remakes them when a chapter changes.
# The other pages are in site/content.

set -eu

ROOT=$(cd "$(dirname "$0")/.." && pwd)
SITE=$ROOT/site
LUA=$ROOT/.lua/5.4/bin/lua
BUCKET=howlscript.io
REGION=eu-central-1
README=https://github.com/nilnor/howlscript/blob/main/README.md

fail() {
  echo "site: $*" >&2
  exit 1
}

# Makes a page from a top-level Markdown file. Its first line, `# Title`, becomes the
# page's title, and links to the other files become links to their pages, or to
# GitHub for README.md, which has no page. A link to the manual on howlscript.io
# becomes an internal one, which Zola checks. Further arguments are more sed options.
make_page() {
  src=$1
  page=$2
  shift 2
  title=$(sed -n '1s/^# //p' "$ROOT/$src")
  [ -n "$title" ] || fail "$src doesn't start with a '# Title' line"
  {
    echo '+++'
    echo "# Made from $src by scripts/site: edit that instead"
    echo "title = \"$title\""
    echo '+++'
    sed -e 1d \
      -e "s|](README\\.md|]($README|g" \
      -e 's/](REFERENCE\.md/](@\/reference.md/g' \
      -e 's/](CONVERTING\.md/](@\/converting.md/g' \
      -e 's|](https://howlscript\.io/manual/)|](@/manual/_index.md)|g' \
      "$@" "$ROOT/$src"
  } >"$SITE/content/$page"
}

# Makes the manual's pages in content/manual from the chapters in manual
make_manual() {
  mkdir -p "$SITE/content/manual"
  "$LUA" "$ROOT/scripts/make-manual.lua" "$ROOT/.stylua/stylua" "$SITE/stylua.toml" \
    "$SITE/content/manual" "$SITE"/manual/*.md
}

# Remakes the manual's pages whenever a chapter changes, for `serve`. A chapter
# changed while they're being made is newer than the next stamp, so it's seen then
watch_manual() {
  stamp=$(mktemp)
  next=$(mktemp)
  trap 'rm -f "$stamp" "$next"; exit' TERM
  while sleep 1; do
    touch "$next"
    if [ -n "$(find "$SITE/manual" -name '*.md' -newer "$stamp")" ]; then
      make_manual || true
    fi
    mv "$next" "$stamp"
    next=$(mktemp)
  done
}

# Gives each file the pages link by hash (get_url's cachebust, which adds `?h=`) a
# copy under the hash, as in hashed/fc6ee1a4709133d95252/style.css, and links that
# instead. S3 ignores the query, so a request for a new hash made before the deploy
# would get the old file, which Cloudflare would then keep a year under the new
# URL. A copy of its own can only be missing then, and a 404 is kept a minute
fingerprint() {
  public=$SITE/public
  grep -rhoE '/[A-Za-z0-9_.-]+\?h=[0-9a-f]+' "$public" --include='*.html' | sort -u |
    while IFS= read -r link; do
      file=${link%%\?*}
      hash=${link##*=}
      mkdir -p "$public/hashed/$hash"
      cp "$public$file" "$public/hashed/$hash$file"
    done
  find "$public" -name '*.html' | while IFS= read -r page; do
    sed -E 's#/([A-Za-z0-9_.-]+)\?h=([0-9a-f]+)#/hashed/\2/\1#g' "$page" >"$page.tmp"
    mv "$page.tmp" "$page"
  done
}

[ $# -gt 0 ] || set -- build
case $1 in
  build | serve | check) ;;
  deploy) command -v aws >/dev/null || fail "deploying needs the AWS CLI" ;;
  *) fail "unknown command '$1' (build, serve, check or deploy)" ;;
esac

[ -x "$LUA" ] || fail "making the manual needs Lua 5.4: run scripts/setup-lua 5.4"
"$ROOT/scripts/setup-zola"
"$ROOT/scripts/setup-stylua"
make_page REFERENCE.md reference.md
# Zola puts a fence's name=... on its pre as data-name, which the CSS shows as a label
make_page CONVERTING.md converting.md \
  -e 's/^\( *```moonscript\)$/\1,name=MoonScript/' \
  -e 's/^\( *```howl\)$/\1,name=Howlscript/'
# Pages of chapters since removed go too
rm -rf "$SITE/content/manual"
make_manual

# Zola runs in the background too, as a signal waits for a foreground command to end
# before its trap runs, while it interrupts `wait`. Background commands ignore
# Ctrl+C, so the trap stops both
if [ "$1" = serve ]; then
  watch_manual &
  watcher=$!
  "$ROOT/.zola/zola" --root "$SITE" "$@" &
  zola=$!
  trap 'kill "$watcher" "$zola" 2>/dev/null' EXIT
  trap 'exit 130' INT TERM
  wait "$zola"
  exit
fi

if [ "$1" = deploy ]; then
  shift
  "$ROOT/.zola/zola" --root "$SITE" build
  fingerprint
  export AWS_PROFILE="${AWS_PROFILE:-howlscript}"
  # Everything is uploaded, as a file's Cache-Control is set only when it's uploaded.
  # First the copies under hashed/: kept a year, as a change gives them a new URL.
  # A page uploaded before them would link a file not there yet
  aws s3 cp "$SITE/public" "s3://$BUCKET" --recursive --region "$REGION" \
    --exclude '*' --include 'hashed/*' \
    --cache-control 'max-age=31536000, immutable' "$@"
  # The 404 page, kept a minute, as S3 sends it with its own Cache-Control for a
  # missing file: so a hashed file requested before it was uploaded is missing only
  # that long
  aws s3 cp "$SITE/public/404.html" "s3://$BUCKET/404.html" --region "$REGION" \
    --cache-control 'max-age=60' "$@"
  # Then the pages and the rest, kept an hour. That includes the hashed files under
  # their own names, which pages cached before the hashed/ copies link
  aws s3 cp "$SITE/public" "s3://$BUCKET" --recursive --region "$REGION" \
    --exclude 'hashed/*' --exclude 404.html \
    --cache-control 'max-age=3600' "$@"
  # Then away with what the build no longer has, but for the hashed files of earlier
  # deploys, which pages cached for up to an hour may still link. Comparing sizes
  # only, it uploads nothing again, which would drop the Cache-Control
  exec aws s3 sync "$SITE/public" "s3://$BUCKET" --delete --size-only \
    --exclude 'hashed/*' --region "$REGION" "$@"
fi
if [ "$1" = build ]; then
  "$ROOT/.zola/zola" --root "$SITE" "$@"
  fingerprint
  exit
fi
exec "$ROOT/.zola/zola" --root "$SITE" "$@"
