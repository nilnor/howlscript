#! /bin/sh
#
# Copyright 2026 Nils Nordman
# License: MIT (see LICENSE.md at the top-level directory of the distribution)
#
# Builds the website into site/public with Zola, which scripts/setup-zola fetches.
# `site serve` serves it on http://127.0.0.1:1111 instead, rebuilding on changes,
# and `site check` checks its links. Further arguments go to Zola, as in
# `site build --base-url https://example.org`.
#
# `site deploy` builds it and syncs it to the S3 bucket behind howlscript.io, with
# the AWS CLI, deleting what the build no longer has. It uses the AWS profile
# `howlscript` unless AWS_PROFILE names another. Further arguments go to
# `aws s3 sync`, as in `site deploy --dryrun`.
#
# The reference and converting pages are made from REFERENCE.md and CONVERTING.md
# each time this runs, so `serve` doesn't pick up changes to those. The other pages
# are in site/content.

set -eu

ROOT=$(cd "$(dirname "$0")/.." && pwd)
SITE=$ROOT/site
BUCKET=howlscript.io
REGION=eu-central-1
README=https://github.com/nilnor/howlscript/blob/main/README.md

fail() {
  echo "site: $*" >&2
  exit 1
}

# Makes a page from a top-level Markdown file. Its first line, `# Title`, becomes the
# page's title, and links to the other files become links to their pages, or to
# GitHub for README.md, which has no page.
make_page() {
  title=$(sed -n '1s/^# //p' "$ROOT/$1")
  [ -n "$title" ] || fail "$1 doesn't start with a '# Title' line"
  {
    echo '+++'
    echo "# Made from $1 by scripts/site: edit that instead"
    echo "title = \"$title\""
    echo '+++'
    sed -e 1d \
      -e "s|](README\\.md|]($README|g" \
      -e 's/](REFERENCE\.md/](@\/reference.md/g' \
      -e 's/](CONVERTING\.md/](@\/converting.md/g' \
      "$ROOT/$1"
  } >"$SITE/content/$2"
}

[ $# -gt 0 ] || set -- build
case $1 in
  build | serve | check) ;;
  deploy) command -v aws >/dev/null || fail "deploying needs the AWS CLI" ;;
  *) fail "unknown command '$1' (build, serve, check or deploy)" ;;
esac

"$ROOT/scripts/setup-zola"
make_page REFERENCE.md reference.md
make_page CONVERTING.md converting.md

if [ "$1" = deploy ]; then
  shift
  "$ROOT/.zola/zola" --root "$SITE" build
  export AWS_PROFILE="${AWS_PROFILE:-howlscript}"
  exec aws s3 sync "$SITE/public" "s3://$BUCKET" --delete --region "$REGION" "$@"
fi
exec "$ROOT/.zola/zola" --root "$SITE" "$@"
